PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/festa_festum

# JWT
JWT_SECRET=ganti_dengan_secret_yang_panjang_dan_acak
JWT_EXPIRES_IN=1d

# Origin browser yang boleh manggil API, pisah koma.
# Kosong = default localhost:5173,4173 (dev server Vite).
CORS_ORIGINS=
# Isi 1 HANYA kalau di belakang proxy (Render/Railway), supaya req.ip benar.
TRUST_PROXY=

# Upstash / Redis (opsional: kalau kosong, soft lock mati dan andalkan constraint DB)
REDIS_URL=

# Midtrans Sandbox — ambil dari dashboard.midtrans.com > Settings > Access Keys.
# Kalau ketiganya dikosongkan, aplikasi tetap jalan dalam MODE SIMULASI:
# nomor VA dibuat lokal dan pembayaran ditandai lunas lewat endpoint simulate.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
